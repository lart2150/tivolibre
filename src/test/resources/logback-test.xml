<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logging for the test suite only; this file is never packaged into either jar.
    The decoder logs a warning per resynchronization, which is expected on recordings
    with signal dropouts, so keep the default at WARN and raise it when debugging.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
